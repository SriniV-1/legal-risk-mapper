# Legal Risk Mapper — Environment Variables
# Copy this file to .env and fill in your values.

# ── Supabase (required for corpus pipeline) ──────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ── SEC EDGAR (optional override) ────────────────────────────────────────────
# SEC requires a User-Agent with your name and email for EDGAR access.
EDGAR_USER_AGENT=YourName your-email@example.com

# ── LLM backend (choose one) ─────────────────────────────────────────────────
# Option A: Groq (recommended — free cloud API, no credit card required)
#   Sign up at https://console.groq.com → Create API Key → paste below
#   The Groq model is chosen by LRM_GROQ_MODEL, not LRM_EXTRACTION_MODEL
#   (that one only names the local Ollama tag — see Option B).
# GROQ_API_KEY=gsk_...
# LRM_GROQ_MODEL=openai/gpt-oss-120b

# Option B: Ollama local (no key needed, requires Ollama running on your machine)
#   Used automatically when GROQ_API_KEY is unset.
# LRM_EXTRACTION_MODEL=llama3.1:8b

# ── Auth ─────────────────────────────────────────────────────────────────────
# By default the public routes (/analyze, /benchmark, /redline, /compare, ...) accept
# anonymous requests — this is how the live demo runs. Set LRM_REQUIRE_AUTH=1 to make
# them demand a JWT (register/login via /auth/*). Admin routes always require a token.
# LRM_REQUIRE_AUTH=0
# Secret for signing JWT tokens. MUST be set if auth is required or /auth/* is used.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET=your-secret-key-here

# ── Server (optional, used by Railway/production) ────────────────────────────
# PORT=8000

# ── CORS (optional, production hardening) ────────────────────────────────────
# Restrict API to specific origins (comma-separated).
# Defaults to localhost:5173,localhost:3000 if unset.
# CORS_ORIGINS=https://legal-risk-mapper.vercel.app

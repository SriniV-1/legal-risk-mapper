# Legal Risk Mapper — Environment Variables
# Copy this file to .env and fill in your values.

# ── Supabase (required for corpus pipeline) ──────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ── SEC EDGAR (optional override) ────────────────────────────────────────────
# SEC requires a User-Agent with your name and email for EDGAR access.
EDGAR_USER_AGENT=YourName your-email@example.com

# ── LLM backend (choose one) ─────────────────────────────────────────────────
# Option A: Groq (recommended — free cloud API, no credit card required)
#   Sign up at https://console.groq.com → Create API Key → paste below
# GROQ_API_KEY=gsk_...
# LRM_EXTRACTION_MODEL=llama-3.1-8b-instant

# Option B: Anthropic (~$0.007/call, fastest quality)
# ANTHROPIC_API_KEY=sk-ant-...
# LRM_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Option C: Ollama local (no key needed, requires Ollama running on your machine)
# LRM_EXTRACTION_MODEL=llama3.1:8b

# ── API Key Auth (optional) ──────────────────────────────────────────────────
# If set, /benchmark and /redline require X-API-Key header.
# If not set, auth is disabled (local dev mode).
# LRM_API_KEY=your-secret-api-key

# ── Server (optional, used by Railway/production) ────────────────────────────
# PORT=8000

# ── CORS (optional, production hardening) ────────────────────────────────────
# Restrict API to your Vercel frontend URL. Defaults to * (allow all) if unset.
# CORS_ORIGINS=https://legal-risk-mapper.vercel.app
